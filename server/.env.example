PORT=5000
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/blogDB

# Recommended: Groq (free, fast, no 429 issues) → https://console.groq.com/keys
AI_PROVIDER=groq
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Optional: Google Gemini → https://aistudio.google.com/apikey
# AI_PROVIDER=gemini
# GEMINI_API_KEY=AIzaSy_your_key_here
